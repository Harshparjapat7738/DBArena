<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.DBArena</groupId>
    <artifactId>platform-common</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>common-web</artifactId>
  <packaging>jar</packaging>

  <name>DBArena :: common-web</name>
  <description>
    Shared RFC 7807 application/problem+json exception handling for every
    HTTP-exposing service. Extracted from four verbatim copies
    (identity-service M14, api-gateway M14, catalog-service M13,
    ai-assistant-service M16) - each service's own Session Log flagged the
    next copy as overdue for exactly this extraction ("do it the next time
    a fifth HTTP service needs this, not a sixth copy-paste"; this audit
    pass did it instead of waiting for a fifth service). Auto-configured
    via META-INF/spring/...AutoConfiguration.imports, the same mechanism
    common-security already uses - no per-service @Import or
    component-scan change needed, just a dependency.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.DBArena</groupId>
        <artifactId>platform-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.DBArena</groupId>
      <artifactId>common-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.DBArena</groupId>
      <artifactId>common-security</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
