{
  "type": "record",
  "name": "OutboxDispatchedEvent",
  "namespace": "com.dbforge.common.events.avro",
  "doc": "Envelope shape every service-specific event payload is wrapped in when it leaves the outbox. Individual services define their own payload schemas separately; this one is the generic transport envelope used to exercise the codegen + serializer path in common-events itself.",
  "fields": [
    { "name": "eventId", "type": "string", "doc": "Same value as the outbox row id - the idempotency key downstream consumers dedupe on." },
    { "name": "eventType", "type": "string" },
    { "name": "aggregateType", "type": "string" },
    { "name": "aggregateId", "type": "string" },
    { "name": "occurredAtEpochMillis", "type": "long" },
    { "name": "schemaVersion", "type": "int", "default": 1 },
    { "name": "payload", "type": "bytes", "doc": "Avro-encoded, service-specific event body." }
  ]
}
