<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.DBArena</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>api-gateway</artifactId>
  <packaging>jar</packaging>

  <name>DBArena :: api-gateway</name>
  <description>
    The single entry point every client talks to. A deliberately minimal
    hand-rolled reverse proxy (Spring MVC + RestClient) rather than
    Spring Cloud Gateway - that keeps the gateway on the same
    Servlet + virtual-threads model as every other service (backend/CLAUDE.md
    "do not rewrite to WebFlux/R2DBC"), and Spring Cloud Gateway's classic
    form requires WebFlux. Rejects unauthenticated requests to
    non-public routes before they reach a backend service; each backend
    service still verifies the token itself too (defense in depth, not
    "trust the gateway").
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.DBArena</groupId>
        <artifactId>platform-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.DBArena</groupId>
      <artifactId>common-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.DBArena</groupId>
      <artifactId>common-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.DBArena</groupId>
      <artifactId>common-web</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.DBArena</groupId>
      <artifactId>common-observability</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
