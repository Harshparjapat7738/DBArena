# DBForge — environment variable template.
#
# Copy this to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored; this file is the checked-in, secret-free reference —
# keep it in sync whenever a service's application.yml gains/removes a var.

# Shared JWT signing secret (HS256, >= 32 bytes) - same value across every
# backend service. Generate one with: openssl rand -base64 48
DBFORGE_JWT_SECRET=

# identity-service (port 8081) - Postgres
DBFORGE_IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/dbforge_identity
DBFORGE_IDENTITY_DB_USER=dbforge
DBFORGE_IDENTITY_DB_PASSWORD=dbforge

# catalog-service (port 8083) - MongoDB
DBFORGE_CATALOG_MONGO_URI=mongodb://localhost:27017
DBFORGE_CATALOG_MONGO_DATABASE=dbforge_catalog

# api-gateway (port 8080) - downstream service routes
DBFORGE_IDENTITY_SERVICE_URI=http://localhost:8081
DBFORGE_CATALOG_SERVICE_URI=http://localhost:8083
DBFORGE_AI_ASSISTANT_SERVICE_URI=http://localhost:8084

# ai-assistant-service (port 8084) - Groq primary / Gemini fallback
DBFORGE_CATALOG_SERVICE_URI=http://localhost:8083
DBFORGE_DATASETS_ROOT=../../../datasets
DBFORGE_AI_MAX_OUTPUT_TOKENS=220
DBFORGE_AI_HINT_RATE_LIMIT_PER_HOUR=30

DBFORGE_GROQ_API_KEY=
DBFORGE_GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
DBFORGE_GROQ_MODEL=llama-3.3-70b-versatile
DBFORGE_GROQ_TIMEOUT_MS=8000

DBFORGE_GEMINI_API_KEY=
DBFORGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
DBFORGE_GEMINI_MODEL=gemini-3-flash-preview
DBFORGE_GEMINI_TIMEOUT_MS=8000

# frontend/apps/web - server-side only, never NEXT_PUBLIC_
DBFORGE_GATEWAY_URL=http://localhost:8080

# MySQL (engine-adapters/adapter-mysql) - not read by any application.yml yet,
# adapter-mysql is a library module with no Spring service wiring it in (no
# execution-service/B09 exists yet). For local manual testing only; the
# adapter's own integration test uses its own Testcontainers MySQL instance.
DBFORGE_MYSQL_HOST=localhost
DBFORGE_MYSQL_PORT=3306
DBFORGE_MYSQL_USER=dbforge
DBFORGE_MYSQL_PASSWORD=dbforge

# Not yet wired into any service (see backend/CLAUDE.md Session Log, B04 entry):
# Redis, Kafka/Redpanda, S3/MinIO. Add entries here in the same milestone that
# first reads them from application.yml.
