# DBArena — environment variable template.
#
# Copy this to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored; this file is the checked-in, secret-free reference —
# keep it in sync whenever a service's application.yml gains/removes a var.

# Shared JWT signing secret (HS256, >= 32 bytes) - same value across every
# backend service. Generate one with: openssl rand -base64 48
DBArena_JWT_SECRET=

# identity-service (port 8081) - MongoDB
DBArena_IDENTITY_MONGO_URI=mongodb://localhost:27017
DBArena_IDENTITY_MONGO_DATABASE=DBArena_identity

# catalog-service (port 8083) - MongoDB
DBArena_CATALOG_MONGO_URI=mongodb://localhost:27017
DBArena_CATALOG_MONGO_DATABASE=DBArena_catalog

# api-gateway (port 8080 by default - change if something else on your
# machine already owns 8080, and update DBArena_GATEWAY_URL below to match)
DBArena_IDENTITY_SERVICE_URI=http://localhost:8081
DBArena_CATALOG_SERVICE_URI=http://localhost:8083
DBArena_AI_ASSISTANT_SERVICE_URI=http://localhost:8084

# ai-assistant-service (port 8084) - Groq primary / Gemini fallback
DBArena_CATALOG_SERVICE_URI=http://localhost:8083
DBArena_DATASETS_ROOT=../../../datasets
DBArena_AI_MAX_OUTPUT_TOKENS=220
DBArena_AI_HINT_RATE_LIMIT_PER_HOUR=30

DBArena_GROQ_API_KEY=
DBArena_GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
DBArena_GROQ_MODEL=llama-3.3-70b-versatile
DBArena_GROQ_TIMEOUT_MS=8000

DBArena_GEMINI_API_KEY=
DBArena_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
DBArena_GEMINI_MODEL=gemini-3-flash-preview
DBArena_GEMINI_TIMEOUT_MS=8000

# frontend/apps/web - server-side only, never NEXT_PUBLIC_
# NOTE: Next.js does not read this root .env at all - it only auto-loads
# .env* from frontend/apps/web/ itself. Copy this line into
# frontend/apps/web/.env.local too (that file is git-ignored, same as this
# one) or the frontend silently falls back to its hardcoded localhost:8080
# default regardless of what you set here.
DBArena_GATEWAY_URL=http://localhost:8080

# MySQL (engine-adapters/adapter-mysql) - not read by any application.yml yet,
# adapter-mysql is a library module with no Spring service wiring it in (no
# execution-service/B09 exists yet). For local manual testing only; the
# adapter's own integration test uses its own Testcontainers MySQL instance.
DBArena_MYSQL_HOST=localhost
DBArena_MYSQL_PORT=3306
DBArena_MYSQL_USER=DBArena
DBArena_MYSQL_PASSWORD=DBArena

# Not yet wired into any service (see backend/CLAUDE.md Session Log, B04 entry):
# Redis, Kafka/Redpanda, S3/MinIO. Add entries here in the same milestone that
# first reads them from application.yml.
